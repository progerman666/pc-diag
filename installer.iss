; Script generated by the Inno Setup Script Wizard.

#define MyAppName "pc-diag"
#define MyAppVersion "1.1.0"
#define MyAppPublisher "progerman666"
#define MyAppURL "https://pc-diag.ru"
#define MyAppExeName "pc-diag.exe"

[Setup]
; РЈРЅРёРєР°Р»СЊРЅС‹Р№ РёРґРµРЅС‚РёС„РёРєР°С‚РѕСЂ РїСЂРёР»РѕР¶РµРЅРёСЏ
AppId={{CB86DFB5-B60F-4E44-8EA9-9DCF46D0DA66}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
; РЈСЃС‚Р°РЅРѕРІРєР° РІ C:\Program Files\pc-diag
DefaultDirName={autopf}\{#MyAppName}
DisableProgramGroupPage=yes
; РўРѕР»СЊРєРѕ РґР»СЏ 64-Р±РёС‚РЅС‹С… СЃРёСЃС‚РµРј
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
; РўСЂРµР±СѓСЋС‚СЃСЏ РїСЂР°РІР° Р°РґРјРёРЅРёСЃС‚СЂР°С‚РѕСЂР° РґР»СЏ СѓСЃС‚Р°РЅРѕРІРєРё РІ Program Files
PrivilegesRequired=admin
; РљСѓРґР° СЃРѕС…СЂР°РЅСЏС‚СЊ РіРѕС‚РѕРІС‹Р№ СѓСЃС‚Р°РЅРѕРІС‰РёРє
OutputDir=C:\Users\dlypo\Output
OutputBaseFilename=pc-diag-setup
; РЎР¶Р°С‚РёРµ
Compression=lzma2
SolidCompression=yes
; РЎРѕРІСЂРµРјРµРЅРЅС‹Р№ РІРёРґ СѓСЃС‚Р°РЅРѕРІС‰РёРєР°
WizardStyle=modern
; РРєРѕРЅРєР° РІ "РЈСЃС‚Р°РЅРѕРІРєР° Рё СѓРґР°Р»РµРЅРёРµ РїСЂРѕРіСЂР°РјРј"
UninstallDisplayIcon={app}\{#MyAppExeName}

[Languages]
Name: "russian"; MessagesFile: "compiler:Languages\Russian.isl"
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; РљРѕРїРёСЂСѓРµРј Р’РЎРЃ СЃРѕРґРµСЂР¶РёРјРѕРµ РїР°РїРєРё dist\pc-diag (РІРєР»СЋС‡Р°СЏ exe, _internal Рё assets)
Source: "D:\projects\pc-diag\dist\pc-diag\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
; РЇСЂР»С‹РєРё С‚РµРїРµСЂСЊ РІРµРґСѓС‚ РїСЂСЏРјРѕ РЅР° exe (РіСЂР°С„РёС‡РµСЃРєРёР№ РёРЅС‚РµСЂС„РµР№СЃ)
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; WorkingDir: "{app}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; WorkingDir: "{app}"; Tasks: desktopicon

[Run]
; Р—Р°РїСѓСЃРє РїСЂРѕРіСЂР°РјРјС‹ РїРѕСЃР»Рµ СѓСЃС‚Р°РЅРѕРІРєРё
Filename: "{app}\{#MyAppExeName}"; Description: "Р—Р°РїСѓСЃС‚РёС‚СЊ {#MyAppName}"; Flags: nowait postinstall skipifsilent
