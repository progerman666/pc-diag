; Script generated by the Inno Setup Script Wizard.

#define MyAppName "pc-diag"
#define MyAppVersion "1.1.0"
#define MyAppPublisher "progerman666"
#define MyAppURL "https://pc-diag.ru"
#define MyAppExeName "pc-diag.exe"

[Setup]
; Уникальный идентификатор приложения
AppId={{CB86DFB5-B60F-4E44-8EA9-9DCF46D0DA66}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
; Установка в C:\Program Files\pc-diag
DefaultDirName={autopf}\{#MyAppName}
DisableProgramGroupPage=yes
; Только для 64-битных систем
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
; Требуются права администратора для установки в Program Files
PrivilegesRequired=admin
; Куда сохранять готовый установщик
OutputDir=C:\Users\dlypo\Output
OutputBaseFilename=pc-diag-setup
; Сжатие
Compression=lzma2
SolidCompression=yes
; Современный вид установщика
WizardStyle=modern
; Иконка в "Установка и удаление программ"
UninstallDisplayIcon={app}\{#MyAppExeName}

[Languages]
Name: "russian"; MessagesFile: "compiler:Languages\Russian.isl"
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; Копируем ВСЁ содержимое папки dist\pc-diag (включая exe, _internal и assets)
Source: "D:\projects\pc-diag\dist\pc-diag\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
; Ярлыки теперь ведут прямо на exe (графический интерфейс)
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; WorkingDir: "{app}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; WorkingDir: "{app}"; Tasks: desktopicon

[Run]
; Запуск программы после установки
Filename: "{app}\{#MyAppExeName}"; Description: "Запустить {#MyAppName}"; Flags: nowait postinstall skipifsilent